<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep sensitive SMS database strictly local on device to comply with Google Play Data Safety & Play Protect -->
        <exclude domain="database" path="dual_sim_sms_database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="dual_sim_sms_database" />
    </device-transfer>
</data-extraction-rules>
